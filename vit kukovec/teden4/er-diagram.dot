digraph ER {
  graph [rankdir=LR, splines=spline, bgcolor="white", fontname="Helvetica", nodesep=0.9, ranksep=1.3];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=11, color="#4C56A6", penwidth=1.4];

  users [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#4C56A6">
      <TR><TD BGCOLOR="#4C56A6"><FONT COLOR="white"><B>USERS</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>PK  id</U>  INT</TD></TR>
      <TR><TD ALIGN="LEFT">username  VARCHAR(50)  UNIQUE</TD></TR>
      <TR><TD ALIGN="LEFT">email  VARCHAR(150)  UNIQUE</TD></TR>
      <TR><TD ALIGN="LEFT">password_hash  VARCHAR(255)</TD></TR>
      <TR><TD ALIGN="LEFT">failed_attempts  INT</TD></TR>
      <TR><TD ALIGN="LEFT">locked_until  DATETIME</TD></TR>
      <TR><TD ALIGN="LEFT">created_at  TIMESTAMP</TD></TR>
    </TABLE>
  >];

  transactions [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#4C56A6">
      <TR><TD BGCOLOR="#4C56A6"><FONT COLOR="white"><B>TRANSACTIONS</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>PK  id</U>  INT</TD></TR>
      <TR><TD ALIGN="LEFT"><I>FK  user_id</I>  INT</TD></TR>
      <TR><TD ALIGN="LEFT">type  ENUM(income,expense)</TD></TR>
      <TR><TD ALIGN="LEFT">amount  DECIMAL(10,2)</TD></TR>
      <TR><TD ALIGN="LEFT">category  VARCHAR(50)</TD></TR>
      <TR><TD ALIGN="LEFT">date  DATE</TD></TR>
      <TR><TD ALIGN="LEFT">description  VARCHAR(255)</TD></TR>
      <TR><TD ALIGN="LEFT">created_at  TIMESTAMP</TD></TR>
    </TABLE>
  >];

  budget [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#4C56A6">
      <TR><TD BGCOLOR="#4C56A6"><FONT COLOR="white"><B>BUDGET</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>PK/FK  user_id</U>  INT</TD></TR>
      <TR><TD ALIGN="LEFT">amount  DECIMAL(10,2)</TD></TR>
      <TR><TD ALIGN="LEFT">threshold_percent  INT</TD></TR>
    </TABLE>
  >];

  savings_goal [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#4C56A6">
      <TR><TD BGCOLOR="#4C56A6"><FONT COLOR="white"><B>SAVINGS_GOAL</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>PK/FK  user_id</U>  INT</TD></TR>
      <TR><TD ALIGN="LEFT">name  VARCHAR(100)</TD></TR>
      <TR><TD ALIGN="LEFT">target  DECIMAL(10,2)</TD></TR>
      <TR><TD ALIGN="LEFT">current  DECIMAL(10,2)</TD></TR>
    </TABLE>
  >];

  category_budgets [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#4C56A6">
      <TR><TD BGCOLOR="#4C56A6"><FONT COLOR="white"><B>CATEGORY_BUDGETS</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>PK/FK  user_id</U>  INT</TD></TR>
      <TR><TD ALIGN="LEFT"><U>PK  category</U>  VARCHAR(50)</TD></TR>
      <TR><TD ALIGN="LEFT">amount  DECIMAL(10,2)</TD></TR>
    </TABLE>
  >];

  users -> transactions [label="  1 : N  ", dir=none];
  users -> budget [label="  1 : 1  ", dir=none];
  users -> savings_goal [label="  1 : 1  ", dir=none];
  users -> category_budgets [label="  1 : N  ", dir=none];
}
